# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# ---------------------------------------------------------------------------

# Database (SQLite by default for the prototype; swap to Postgres later, e.g.
# postgresql+psycopg2://user:pass@localhost:5432/threatintel)
DATABASE_URL=sqlite:///./threatintel.db

# --- LLM (advisory NLP layer ONLY — never the final verdict) ---------------
# This prototype talks to OpenRouter's OpenAI-compatible endpoint.
# Put YOUR OWN key here. Do not paste keys into shared documents or chats —
# treat any key that has been pasted somewhere outside your secrets manager
# as compromised and rotate it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Optional external intelligence (all fail gracefully if unset) --------
IPINFO_TOKEN=
# If empty, IP geolocation is reported as "unavailable" rather than guessed.

# WHOIS/DNS use local libraries (python-whois, dnspython) and do not need a
# key, but can be flaky/rate-limited from some networks — failures degrade
# to "unavailable" rather than crashing the pipeline.

CORS_ORIGINS=http://localhost:5173
